# VigilantLink Backend Environment Variables
# Copy this file to .env and fill in your values

# VirusTotal API Key (required for real-time threat intelligence)
# Get your free API key at: https://www.virustotal.com/gui/my-apikey
# Free tier limits: 4 requests/minute
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# Optional: Override default settings
# BACKEND_HOST=127.0.0.1
# BACKEND_PORT=8000
# LOG_LEVEL=info
