# VigilantLink Backend Environment Variables
# Copy this file to .env and fill in your values

# Google Safe Browsing API Key (required for real-time threat intelligence)
GOOGLE_SAFE_BROWSING_API_KEY=your_google_safe_browsing_api_key_here

# PhishTank and OpenPhish require no API keys


# Optional: Override default settings
# BACKEND_HOST=127.0.0.1
# BACKEND_PORT=8000
# LOG_LEVEL=info
