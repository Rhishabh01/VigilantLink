# VigilantLink Backend Environment Variables
# Copy this file to .env and fill in your values

# Google Safe Browsing API Key (required for real-time threat intelligence)
GOOGLE_SAFE_BROWSING_API_KEY=your_google_safe_browsing_api_key_here

# PhishTank and OpenPhish require no API keys


# Optional: Override default settings
# BACKEND_HOST=127.0.0.1
# BACKEND_PORT=8000
# LOG_LEVEL=info

# Keep-alive self-ping (prevents Render free-tier spin-down)
# Set KEEP_ALIVE_URL to your deployed backend URL in production.
# Leave unset for local development (no pinging).
# KEEP_ALIVE_URL=https://your-app.onrender.com
# KEEP_ALIVE_INTERVAL_S=600
